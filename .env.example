# Copy to .env.local and fill in. .env.local is gitignored.

# Public site URL (canonical, sitemap, OG). Defaults to https://www.inkorangestudios.com
NEXT_PUBLIC_SITE_URL=https://www.inkorangestudios.com

# Sanity: same project and dataset as ~/web/portfolio
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor-role token required for `npm run seed` (the script prefers SANITY_WRITE_TOKEN, falls back to SANITY_API_TOKEN).
SANITY_WRITE_TOKEN=
# Editor role; the newsletter reads drafts and writes delivery status. Also a fallback for `npm run seed`.
SANITY_API_TOKEN=
# Shared secret for the Sanity -> /api/revalidate webhook
SANITY_REVALIDATE_SECRET=

# Supabase: shared project, studio_* tables, service role only (server only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postmark server token. Also sends the newsletter confirmation emails and broadcasts.
# Notification email for feedback/signups: missing values never fail a submission.
POSTMARK_SERVER_TOKEN=
FEEDBACK_FROM_EMAIL=
FEEDBACK_NOTIFY_EMAIL=thrillgraphics@gmail.com

# Newsletter (Postmark broadcast stream). Missing values disable sending, never break the site.
# Verified From address on the Postmark sender signature
NEWSLETTER_FROM_EMAIL=
# Where "send test" issues go
NEWSLETTER_TEST_EMAIL=
# Optional: where subscriber replies go (Reply-To on issues, tests and confirmation emails). Unset = replies go to NEWSLETTER_FROM_EMAIL.
NEWSLETTER_REPLY_TO=
# Postmark message stream id for broadcasts
POSTMARK_BROADCAST_STREAM=broadcast
# Shared secret for the Sanity -> newsletter send webhook
NEWSLETTER_WEBHOOK_SECRET=
# Basic-auth credentials configured on the Postmark Subscription Change webhook
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=

# Cloudflare Turnstile (spam protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Tag Manager container id (loads only after consent)
NEXT_PUBLIC_GTM_ID=
