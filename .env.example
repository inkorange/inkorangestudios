# Copy to .env.local and fill in. .env.local is gitignored.

# Public site URL (canonical, sitemap, OG). Defaults to https://inkorangestudios.com
NEXT_PUBLIC_SITE_URL=https://inkorangestudios.com

# Sanity: same project and dataset as ~/web/portfolio
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Read token for draft/preview content (server only)
# Editor-role token required for `npm run seed` (scripts prefer SANITY_WRITE_TOKEN, fall back to SANITY_API_TOKEN).
SANITY_WRITE_TOKEN=
SANITY_API_TOKEN=
# Shared secret for the Sanity -> /api/revalidate webhook
SANITY_REVALIDATE_SECRET=

# Supabase: shared project, studio_* tables, service role only (server only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postmark: notification email for feedback/signups. Missing values never fail a submission.
POSTMARK_SERVER_TOKEN=
FEEDBACK_FROM_EMAIL=
FEEDBACK_NOTIFY_EMAIL=thrillgraphics@gmail.com

# Cloudflare Turnstile (spam protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Tag Manager container id (loads only after consent)
NEXT_PUBLIC_GTM_ID=
